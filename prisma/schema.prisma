generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model BusinessProfile {
  id                 Int      @id @default(autoincrement())
  businessName       String   @default("")
  ownerName          String   @default("")
  email              String   @default("")
  phone              String   @default("")
  address            String   @default("")
  logoUrl            String?
  signatureUrl       String?
  bankName           String?
  bankAccountName    String?
  bankAccountNumber  String?
  bankBranch         String?
  defaultTheme       Theme    @default(MODERN_BOLD)
  primaryColor       String   @default("#1E3A5F")
  accentColor        String   @default("#059669")
  fontChoice         String   @default("Helvetica")
  invoicePrefix      String   @default("INV")
  nextInvoiceSeq     Int      @default(1)
  invoiceSeqYear     Int      @default(0)
  defaultTerms       String?
  currency           String   @default("IDR")
  updatedAt          DateTime @updatedAt
}

model Client {
  id        String    @id @default(cuid())
  name      String
  company   String?
  email     String?
  phone     String?
  address   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  invoices  Invoice[]
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  UNPAID
}

enum Theme {
  MINIMAL_CLEAN
  MODERN_BOLD
  CLASSIC_PROFESSIONAL
}

enum DiscountType {
  PERCENT
  FIXED
}

enum RecurringInterval {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

model Invoice {
  id             String             @id @default(cuid())
  number         String             @unique
  client         Client             @relation(fields: [clientId], references: [id])
  clientId       String
  issueDate      DateTime           @default(now())
  dueDate        DateTime
  status         InvoiceStatus      @default(DRAFT)
  theme          Theme              @default(MODERN_BOLD)
  currency       String             @default("IDR")
  discountType   DiscountType?
  discountValue  Float              @default(0)
  taxEnabled     Boolean            @default(false)
  taxRate        Float              @default(0)
  notes          String?
  subtotal       Float              @default(0)
  discountAmount Float              @default(0)
  chargesTotal   Float              @default(0)
  taxAmount      Float              @default(0)
  total          Float              @default(0)
  paidAt         DateTime?
  publicToken    String?            @unique
  isRecurring       Boolean            @default(false)
  recurringInterval RecurringInterval?
  recurringNextDate DateTime?
  recurringSourceId String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  items          InvoiceItem[]
  charges        AdditionalCharge[]
  attachments    InvoiceAttachment[]
  payments       PaymentRecord[]

  @@index([clientId])
  @@index([status])
}

model InvoiceItem {
  id            String        @id @default(cuid())
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId     String
  description   String
  qty           Float         @default(1)
  unitPrice     Float         @default(0)
  discountType  DiscountType?
  discountValue Float         @default(0)
  subtotal      Float         @default(0)
  position      Int           @default(0)

  @@index([invoiceId])
}

model AdditionalCharge {
  id        String  @id @default(cuid())
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId String
  label     String
  amount    Float   @default(0)
  isPercent Boolean @default(false)
  position  Int     @default(0)

  @@index([invoiceId])
}

model InvoiceAttachment {
  id        String   @id @default(cuid())
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId String
  filename  String
  url       String
  size      Int
  mimeType  String
  createdAt DateTime @default(now())

  @@index([invoiceId])
}

model PaymentRecord {
  id                String   @id @default(cuid())
  invoice           Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId         String
  amountReceived    Float
  transactionCharge Float    @default(0)
  paymentDate       DateTime @default(now())
  paymentMethod     String?
  note              String?
  createdAt         DateTime @default(now())

  @@index([invoiceId])
}
